# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — 既定で全て無視し、公開してよいテンプレートのみ明示的に許可する
# (.env.local.bak-... のような派生名がすり抜けて公開リポジトリに載る事故があったため)
.env*
!.env.example
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts



# Python solver build artifacts
solver/.venv/
.venv/
venv/
__pycache__/
*.pyc
